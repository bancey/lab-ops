{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  - name: aguard dns external
    group: services
    url: "10.151.14.4"
    dns:
      query-name: "google.co.uk"
      query-type: "A"
    conditions:
      - "[DNS_RCODE] == NOERROR"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  - name: adguard dns internal
    group: services
    url: "10.151.14.4"
    dns:
      query-name: "hass.tiny.heimelska.co.uk"
      query-type: "A"
    conditions:
      - "[DNS_RCODE] == NOERROR"
      - "[BODY] == 10.151.24.10"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  - name: home assistant
    group: services
    url: "https://hass.tiny.heimelska.co.uk"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == pat(*<title>Home Assistant</title>*)"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  - name: home assistant waf
    group: services
    url: "https://hass.heimelska.co.uk"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == pat(*<title>Home Assistant</title>*)"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  # Behind Entra SSO, so an unauthenticated probe gets redirected rather than served the UI.
  # The 302 still proves Traefik, the route and oauth2-proxy are alive.
  - name: zigbee2mqtt
    group: services
    url: "https://zigbee2mqtt.tiny.heimelska.co.uk"
    interval: 1m
    conditions:
      - "[STATUS] == 302"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}

  # oauth2-proxy's health endpoint: the thing to check first when every SSO-protected service
  # starts failing at once.
  - name: sso tiny
    group: services
    url: "https://auth.tiny.heimelska.co.uk/ping"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
  - name: sso wanda
