storage:
  type: sqlite
  path: /data/data.db

web:
  read-buffer-size: 32768

ui:
  header: BanceTech Service Status
  link: "https://gatus.{{ inventory_hostname }}.heimelska.co.uk"
  default-sort-by: group
  buttons:
{% for host in groups['rpi'] if host != inventory_hostname %}
    - name: {{ host }}
      link: "https://gatus.{{ host }}.heimelska.co.uk"
{% endfor %}

{% set oidc_client_id = gatus_oidc_client_id | default('') | trim %}
{% set oidc_client_secret = gatus_oidc_client_secret | default('') | trim %}
{% if oidc_client_id | length > 0 and oidc_client_secret | length > 0 %}
# Gatus has no group-based authorization, so allowed-subjects is the only gate beyond "is in the
# tenant" - set gatus_oidc_allowed_subjects to narrow it to specific accounts.
security:
  oidc:
    issuer-url: "https://login.microsoftonline.com/{{ gatus_oidc_tenant_id }}/v2.0"
    redirect-url: "https://gatus.{{ inventory_hostname }}.heimelska.co.uk/authorization-code/callback"
    client-id: "{{ oidc_client_id }}"
    client-secret: "{{ oidc_client_secret }}"
    scopes: ["openid"]
{% if gatus_oidc_allowed_subjects | default([]) | length > 0 %}
    allowed-subjects:
{% for subject in gatus_oidc_allowed_subjects %}
      - "{{ subject }}"
{% endfor %}
{% endif %}
{% endif %}

{% set discord_webhook = gatus_discord_webhook_url | default('') | trim %}
{% set discord_enabled = discord_webhook | length > 0 %}
{% if discord_enabled %}
alerting:
  discord:
    webhook-url: "{{ discord_webhook }}"
    title: ":helmet_with_white_cross: Gatus ({{ inventory_hostname }})"
    message-content: "@bancey"
{% endif %}

endpoints:
  - name: thanos
    group: hosts
    url: "tcp://thanos.heimelska.co.uk:22"
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
      - "[IP] == 10.151.14.5"
{% if discord_enabled %}
    alerts:
      - type: discord
        send-on-resolved: true
{% endif %}
